# Server Configuration
PORT=5000
NODE_ENV=production

# Neon PostgreSQL Database Connection Strings
# Use pooled connection URL for application queries:
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/brightloop?sslmode=require"
# Use direct connection URL for Prisma migrations (optional for pooled setups):
DIRECT_URL="postgresql://user:password@ep-xyz.region.neon.tech/brightloop?sslmode=require"

# Security & Authentication
# Generate high-entropy strings for production (e.g. openssl rand -base64 32)
JWT_SECRET="brightloop-super-secure-jwt-secret-replace-in-production-min-16-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="brightloop-super-secure-cookie-secret-replace-in-production-min-16-chars"

# Cookie Security & Cross-Domain Settings
# 'none' (recommended for cross-site deployments like Vercel frontend + Render backend)
# 'lax' (recommended for same-domain deployments or local development)
COOKIE_SAME_SITE="none"

# CORS Configuration
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example: "http://localhost:5173,https://brightloop.vercel.app"
CORS_ORIGIN="http://localhost:5173,https://brightloop.vercel.app"
