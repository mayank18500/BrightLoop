# Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection Strings
# Use pooled connection URL for application queries:
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/brightloop?sslmode=require"
# Use direct connection URL for Prisma migrations (optional for pooled setups):
DIRECT_URL="postgresql://user:password@ep-xyz.region.neon.tech/brightloop?sslmode=require"

# Security & Authentication
JWT_SECRET="brightloop-super-secure-jwt-secret-replace-in-production"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="brightloop-super-secure-cookie-secret-replace-in-production"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"
