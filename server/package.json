{
  "name": "brightloop-server",
  "version": "1.0.0",
  "description": "BrightLoop Subscription & Recurring Billing API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:auth": "tsx src/tests/testAuth.ts",
    "test:catalog": "tsx src/tests/testCatalog.ts",
    "test:quotations": "tsx src/tests/testQuotations.ts",
    "test:subscriptions": "tsx src/tests/testSubscriptions.ts",
    "test:invoices": "tsx src/tests/testInvoices.ts",
    "test:payments": "tsx src/tests/testPayments.ts",
    "test:reports": "tsx src/tests/testReports.ts",
    "test:all": "npm run test:auth && npm run test:catalog && npm run test:quotations && npm run test:subscriptions && npm run test:invoices && npm run test:payments && npm run test:reports"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.17.19",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "bcrypt@5.1.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
